{
  "name": "siteysense-ai",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy --env-file-if-exists=.env server.js",
    "dev": "node --use-env-proxy --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:camera": "node scripts/live-camera-smoke.mjs",
    "test:tasks": "node scripts/tasks-smoke.mjs",
    "test:weather": "node scripts/weather-smoke.mjs",
    "test:live": "node scripts/live-review-smoke.mjs",
    "test:speech": "node scripts/speech-smoke.mjs"
  },
  "engines": {
    "node": ">=24.5"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
