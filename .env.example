# Copy to .env and set your real key locally. Never commit .env.
GEMINI_API_KEY=
# Phone photo and quick-frame checks:
GEMINI_MODEL=gemini-2.5-flash
# Native Interactions API agentic video (confirm access in your account):
GEMINI_VIDEO_MODEL=gemini-3.8-flash
PORT=3000

# Experimental extra visual schema; keep off until you evaluate it.
GEMINI_EXTENDED_CHECKS=false

# Enable explicitly after configuring authorized Live model access.
GEMINI_LIVE_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
# Separate team access code to protect your public Live endpoint. Never use the API key as this code.
SITEYSENSE_LIVE_CODE=
