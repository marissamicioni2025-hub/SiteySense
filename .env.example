# Copy to .env and set your real key locally. Never commit .env.
GEMINI_API_KEY=
# Phone photo and quick-frame checks:
GEMINI_MODEL=gemini-2.5-flash
# Native Interactions API agentic video (confirm access in your account):
GEMINI_VIDEO_MODEL=gemini-3.8-flash
PORT=3000

# Experimental extra visual schema; keep off until you evaluate it.
GEMINI_EXTENDED_CHECKS=false
